{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "agent": {
    "build": {
      "model": "ai-proxy-openai-us/gpt-6-sol",
      "variant": "medium"
    },
    "plan": {
      "model": "ai-proxy-openai-us/gpt-6-sol",
      "variant": "high"
    },
    "explore": {
      "model": "headroom-compat/anthropic/claude-haiku-4-5-20251001",
      "options": {},
      "permission": {}
    },
    "planning-deep": {
      "description": "Deep planning with Claude Opus for complex, multi-step design work.",
      "mode": "primary",
      "model": "ai-proxy-anthropic/anthropic/claude-opus-4-8",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    }
  },
  "permission": "allow",
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    },
    "google-docs": {
      "type": "remote",
      "url": "https://docsmcp.googleapis.com/mcp/v1",
      "enabled": true
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/v1/mcp",
      "oauth": {},
      "enabled": true
    }
  },
  "plugin": [
    "@whisperopencode/push"
  ]
}
