      "mode": "primary",
      "model": "ai-proxy-anthropic/anthropic/claude-opus-4-8",
      "permission": {
        "edit": "deny"
      }
    },
    "explore": {
      "model": "headroom-compat/anthropic/claude-haiku-4-5-20251001",
      "options": {},
      "permission": {}
    }
  },
  "mode": {
    "build": {
      "model": "custom-fireworks/accounts/fireworks/routers/glm-5p2-fast",
      "options": {},
      "permission": {}
    },
    "plan": {
      "model": "custom-fireworks/accounts/fireworks/routers/glm-5p2-fast",
      "options": {},
      "permission": {}
    }
  },
  "permission": "allow",
  "mcp": {
    "linear": {
      "type": "remote",
      "url": "https://mcp.linear.app/mcp",
      "enabled": true
    }
  },
  "plugin": [
    "@whisperopencode/push"
  ]
